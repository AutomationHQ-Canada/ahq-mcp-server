# Production profile — copy to ~/.testbots/.env.prod
#
# This is the equivalent of application-prod.properties: the base .env holds whatever is true
# everywhere, this file holds only what makes prod prod, and it wins over the base file whenever
# the prod profile is active.
#
# Activate it by putting TESTBOTS_ENV=prod in ~/.testbots/.env (see .env.example), then restart
# your MCP client. Nothing here takes effect until that line is present.
#
# The quicker route is to skip this file entirely and let the CLI write it:
#
#     testbots-login --env=prod        # signs in to prod, writes ~/.testbots/.env.prod
#     testbots-login --use=prod        # makes prod the active profile
#
# Keep dev alongside it as ~/.testbots/.env.dev and switch with --use=dev.

# Prod's API gateway. A minted token normally names its own gateway through its urlDetails
# claim, but pinning it here is what makes this file readable on its own — and it is required
# for password sign-in, which has no claim to read.
TESTBOTS_BASE_URL=https://api.automationhq.ai

# A prod ORGANIZATION token. Mint it with `testbots-login --env=prod`, or in the web app under
# Administration -> Settings -> API Tokens. A dev token will not work here: it is validated
# against dev's database, so every call fails or, worse, quietly resolves nothing.
TESTBOTS_API_TOKEN=

# The prod project this profile works in. Project ids differ per environment — copying dev's id
# here is the single most common way to end up connected but looking at an empty workspace.
TESTBOTS_PROJECT_ID=

# No TESTBOTS_ORG_ID on purpose — the organization always comes from the token's own
# organizationId claim. A separately configured one drifts out of sync and silently writes real
# data into the wrong organization.

# Optional: advertise a smaller slice of the tool surface in prod.
# TESTBOTS_MCP_TOOL_PROFILE=core
