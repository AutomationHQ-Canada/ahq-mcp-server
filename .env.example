# --- Profiles ---------------------------------------------------------------------------
# Which environment is active, the same idea as spring.profiles.active. Everything below is the
# base configuration; a profile file (.env.prod / .env.dev, see .env.prod.example) is layered
# over it and wins. Leave this unset to keep the single-environment setup this file describes.
#
#     testbots-login --env=prod     sign in to prod, writing ~/.testbots/.env.prod
#     testbots-login --use=prod     flip the line below to prod
#
# Restart your MCP client after changing it.
# TESTBOTS_ENV=dev

AHQ_API_TOKEN=your-ahq-api-token-here
# No AHQ_ORG_ID here on purpose — org is always derived from the token's own organizationId
# claim (see src/config/credentials.py). Setting one separately would risk it drifting out of
# sync with the token, which silently writes data into the wrong organization.
AHQ_PROJECT_ID=your-project-id-here
# AHQ_BASE_URL is optional — the gateway URL is derived from the token's own urlDetails.baseUrl
# claim (same as AHQ_ORG_ID). Only set this as a fallback for a token that predates that claim,
# and only to the API gateway (e.g. https://api-dev.automationhq.ai), never the web UI.
# AHQ_BASE_URL=https://api-dev.automationhq.ai
LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Seconds check_local_agent_status waits out the first time it sees the local agent online,
# before reporting ready — its /ping answers before the agent's own async startup (token
# revalidation, chromedriver resolution) finishes. Uncomment to tune; default is 15.
# AHQ_LOCAL_AGENT_WARMUP_SECONDS=15
# Advertise a smaller slice of the 137 tools — every schema is sent to the model on every
# message, so a narrower set costs fewer tokens and gives it fewer near-identical options to
# choose between. "core" is 57 tools (half the payload) and keeps all 9 skills working; add
# groups as needed, e.g. "core,api". Unset = all 137. Groups are listed in src/tool_groups.py.
# AHQ_MCP_TOOL_PROFILE=core

# --- Hosted (ahq-mcp-http) mode only — ignore these for the normal stdio plugin setup ---
# AHQ_MCP_AUTH_SECRET=any-long-random-string-same-on-every-replica
# AHQ_MCP_PUBLIC_BASE_URL=https://api-dev.testbots.ai/mcp-server
# AHQ_MCP_RATE_LIMIT_PER_MIN=60
# AHQ_MCP_MAX_BODY_BYTES=2000000
# AHQ_MCP_EXTRA_REDIRECT_URIS=
# AHQ_MCP_CRAWL_CONCURRENCY=2
