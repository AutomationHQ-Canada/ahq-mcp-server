# Development profile — copy to ~/.testbots/.env.dev
#
# The counterpart to .env.prod.example. Keeping both means switching environments is one line in
# ~/.testbots/.env rather than re-pasting credentials, and neither set can overwrite the other.
#
#     testbots-login --env=dev         # signs in to dev, writes ~/.testbots/.env.dev
#     testbots-login --use=dev         # makes dev the active profile

TESTBOTS_BASE_URL=https://api-dev.automationhq.ai
TESTBOTS_API_TOKEN=
TESTBOTS_PROJECT_ID=
